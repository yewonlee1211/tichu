# Copy this file to `.env.production` in the same directory (gitignored) and
# fill in real values before running `pnpm --filter client build` for a real
# deployment. Both vars are read at BUILD time (see src/vite-env.d.ts) --
# changing either one requires re-running the build, not just redeploying
# the existing dist/ output.

# Human-vs-human WS server endpoint (see useGameSocket.ts). Leave unset while
# packages/server has no public deployment -- multiplayer mode simply has
# nothing to connect to yet; solo-AI mode does not use this at all.
# VITE_WS_URL=wss://<server-host>

# Origin the AI model bundle (.onnx.enc + manifest.json) is fetched from at
# runtime (see modelCache.ts). This is the S3 bucket origin from the
# 2026-09-06-m1-model-s3-deploy session, e.g.:
# VITE_MODEL_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com
