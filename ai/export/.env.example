# Copy this file to `.env` in the same directory (export/.env -- gitignored) and
# fill in the checkpoint you want deployed. `export_onnx.py` reads it automatically
# via its `--env-file` default; CLI flags (--checkpoint/--out) still override these
# when passed explicitly.
#
# Re-point CHECKPOINT at a different run/iteration any time a new checkpoint should
# ship -- no code change needed, just edit this file and re-run:
#   docker compose exec ai python -m export.export_onnx
#
# CHECKPOINT is resolved relative to ai/ (the container's /app, per docker-compose.yml).
CHECKPOINT=checkpoints/run1/checkpoint_300.pt

# OUT is resolved the same way. deploy/client-models/ is bind-mounted (see
# docker-compose.yml) to packages/client/public/models/ on the host, so writing here
# lands the file directly where the built client site serves it from -- manifest.json
# is written alongside it automatically.
OUT=deploy/client-models/policy.onnx.enc

# --- deploy_s3.py (S3 deploy step, run after export_onnx.py) ---
# Target bucket + region. Fill in the real bucket name here in your local .env only --
# see ai/export/README.md for the bucket policy, lifecycle rule and IAM policy this
# bucket needs, and don't paste the real name into chat (same handling as everything
# else in this file).
S3_BUCKET=your-bucket-name-here
AWS_REGION=ap-southeast-2

# Access key for the tichu-model-deploy IAM user (least-privilege: PutObject/GetObject
# on this bucket's models/* prefix only -- see ai/export/README.md). Same handling as
# packages/server/.env's DATABASE_URL password: fill these in directly in your local
# .env, never paste them into chat.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
